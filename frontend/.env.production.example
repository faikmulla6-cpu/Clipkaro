# Hostinger Next.js production environment for ClipKaro.
# Browser requests stay same-origin so auth cookies and CSRF remain on clipkaro.pro.
NEXT_PUBLIC_API_URL=/api/v1

# Large videos upload directly to signed GCS URLs instead of passing through
# Hostinger or the Cloud Run API request body.
NEXT_PUBLIC_UPLOAD_MODE=direct_gcs

# Server-only Next.js rewrite destination. Replace after the Cloud Run API is deployed.
# This value is not exposed to browser JavaScript.
BACKEND_URL=https://REPLACE_WITH_CLOUD_RUN_API_URL
