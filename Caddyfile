{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  handle /api/* {
    # Bound request bodies at the public edge. The application independently
    # enforces a 500 MiB video limit; the small allowance here covers multipart
    # framing while rejecting unbounded request bodies before they reach FastAPI.
    # `request_body max_size` is available in Caddy 2.10+ (the deployed image).
    request_body {
      max_size 525MiB
    }

    reverse_proxy api:8000 {
      # The API is not exposed directly by docker-compose. Overwrite this
      # private header at the trusted edge so backend per-client rate limits
      # see the real remote address rather than the shared Caddy container IP.
      header_up X-ClipKaro-Client-IP {remote_host}
      flush_interval -1
    }
  }

  handle {
    reverse_proxy web:3000
  }

  # Edge-level browser policy covers both Next.js pages and API responses. The
  # only third-party origins are Razorpay checkout/payment endpoints. Inline
  # styles/scripts remain allowed because Next.js and Razorpay bootstrap them;
  # object/embed content and framing are denied entirely.
  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://*.razorpay.com\")"
    Cross-Origin-Opener-Policy same-origin-allow-popups
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.razorpay.com; img-src 'self' data: blob: https://*.razorpay.com; media-src 'self' blob: https://storage.googleapis.com https://*.backblazeb2.com https://*.r2.cloudflarestorage.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://*.razorpay.com; connect-src 'self' https://storage.googleapis.com https://*.backblazeb2.com https://*.r2.cloudflarestorage.com https://*.razorpay.com wss://*.razorpay.com; frame-src https://*.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
  }
}
