# Serverless production placeholder template. Never commit real secret values.
APP_ENV=production
DATABASE_BACKEND=postgres
DATABASE_URL=
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=4
POSTGRES_STATEMENT_CACHE_SIZE=0
STORAGE_BACKEND=gcs
GCS_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=
GCS_UPLOAD_URL_TTL_SECONDS=900
GCS_DOWNLOAD_URL_TTL_SECONDS=300
JOB_BACKEND=cloud_run_job
GCP_PROJECT_ID=
GCP_REGION=
CLOUD_RUN_MEDIA_JOB_NAME=
JOB_CLAIM_STALE_SECONDS=1800
# Legacy VPS variables below remain only for optional historical deployment.
DOMAIN=REPLACE_WITH_DOMAIN
ACME_EMAIL=
SECRET_KEY=replace-with-a-generated-64-byte-secret
# Set true only after all provider secrets used for paid launch were generated/rotated
# after any plaintext exposure and installed only in the private VPS .env/secret store.
PRODUCTION_CREDENTIALS_ROTATED=false
# Defense in depth: production creator accounts can never use manual analysis.
ALLOW_MANUAL_ANALYSIS_IN_DEVELOPMENT=false
RAZORPAY_MODE=live
ALLOW_LIVE_RAZORPAY_IN_DEVELOPMENT=false
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional email. Resend is the preferred provider; SMTP can remain empty
# when Resend is configured. Verify the sending domain before public launch.
FRONTEND_URL=https://clipkaro.pro
CORS_ORIGINS=https://clipkaro.pro
RESEND_API_KEY=
EMAIL_FROM=ClipKaro AI <verify@mail.REPLACE_WITH_DOMAIN>
RESEND_TIMEOUT_SECONDS=15

# PUBLIC legal/consumer particulars — these are not secrets and are intentionally
# published in /legal-notice and /privacy. Replace every required placeholder
# before accepting paid users. ClipKaro's paid-launch checks reject placeholders.
LEGAL_OPERATOR_NAME=REPLACE_WITH_LEGAL_ENTITY_OR_PROPRIETOR_NAME
LEGAL_OPERATOR_ADDRESS=REPLACE_WITH_PRINCIPAL_GEOGRAPHIC_ADDRESS
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
CUSTOMER_CARE_EMAIL=
CUSTOMER_CARE_PHONE=REPLACE_WITH_CUSTOMER_CARE_PHONE
GRIEVANCE_OFFICER_NAME=REPLACE_WITH_GRIEVANCE_OFFICER_NAME
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=REPLACE_WITH_GRIEVANCE_PHONE
# Fill these when applicable to the actual operator. Never invent them.
LEGAL_GSTIN=
LEGAL_PAN=

# Revocable sessions and password recovery. Successful reset invalidates all devices.
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

# Upload security runs inside the isolated media job; the API never needs a VPS sidecar.
UPLOAD_SCAN_REQUIRED=true
CLAMAV_HOST=local
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_CHUNK_KB=256
# Keep all daemon scan ceilings above ClipKaro's 500 MB application upload maximum.
CLAMAV_STREAM_MAX_LENGTH=550M
CLAMAV_MAX_FILE_SIZE=550M
CLAMAV_MAX_SCAN_SIZE=550M
CLAMAV_FRESHCLAM_CHECKS=24

# Isolated Cloud Run media job owns provider calls, scanning, and FFmpeg.
WORKER_POLL_SECONDS=0.75
WORKER_HEARTBEAT_SECONDS=5
WORKER_STALE_AFTER_SECONDS=30
WORKER_PROVIDER_PROBE_SECONDS=300
PREFLIGHT_NETWORK_TIMEOUT_SECONDS=8
FILE_EXPIRY_HOURS=24
MEDIA_PROCESS_TIMEOUT_SECONDS=1800
MEDIA_FFMPEG_THREADS=2
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.25
API_PIDS_LIMIT=128
WORKER_MEMORY_LIMIT=4g
WORKER_CPU_LIMIT=3.0
WORKER_PIDS_LIMIT=256
WEB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=0.75
WEB_PIDS_LIMIT=128
# Legacy optional VPS resource variables are ignored by Cloud Run.
CLAMAV_MEMORY_LIMIT=3g
CLAMAV_CPU_LIMIT=1.0
CLAMAV_PIDS_LIMIT=128

# Email verification protects the free AI quota from throwaway-account abuse.
# Resend above is preferred for all transactional mail. SMTP below is an optional
# fallback; leave it empty when Resend is configured and verified.
EMAIL_VERIFICATION_REQUIRED=true
APP_PUBLIC_URL=https://clipkaro.pro
EMAIL_VERIFICATION_TOKEN_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ClipKaro AI
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Semantic best-moment ranking. These keys are mounted only into the media worker.
GROQ_RANKING_ENABLED=true
GROQ_RANKING_MODEL=openai/gpt-oss-120b
GROQ_RANKING_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_RANKING_TIMEOUT_SECONDS=18
GROQ_RANKING_CANDIDATES=16
# Preferred comma-separated key pool. Used for credential redundancy, not rate-limit bypass.
GROQ_API_KEYS=
# Or store the existing keys as separate secret slots instead of GROQ_API_KEYS.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Controlled Hinglish route. The generic launch template fails closed.
# Enable only after deliberately restoring the previously qualified private cohort
# with real authenticated user IDs in the private production environment.
HINGLISH_ASR_PROVIDER=legacy
ROMAN_HINGLISH_ENABLED=true
ROMAN_HINGLISH_POLICY=v3
ROMAN_HINGLISH_DISPLAY_POLICY=v1
HINGLISH_STAGE1_ENABLED=false
HINGLISH_STAGE1_USER_IDS=
ELEVENLABS_API_KEYS=
ELEVENLABS_ASR_CHUNK_SECONDS=300
ELEVENLABS_ASR_TIMEOUT_SECONDS=120

# API-first ASR: Groq primary, Cloudflare Workers AI fallback. Keep all secrets
# in Cloud Run secret references only. The production media image is the
# lightweight API/provider runtime. If you intentionally switch ASR_MODE=local
# and require faster-whisper/WhisperX, also set WORKER_IMAGE_TARGET=worker before
# rebuilding; never run local ASR inside the lightweight API image.
WORKER_IMAGE_TARGET=media
ASR_MODE=api
ASR_PRIMARY_PROVIDER=groq
ASR_FALLBACK_PROVIDER=cloudflare
GROQ_ASR_MODEL=whisper-large-v3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ASR_MODEL=@cf/openai/whisper-large-v3-turbo
ASR_PROVIDER_TIMEOUT_SECONDS=45
ASR_PROVIDER_MAX_ATTEMPTS=2
ASR_API_MAX_AUDIO_MINUTES=60
ASR_API_MAX_CHUNK_MB=24
ASR_API_MAX_CHUNKS=24
ASR_CHUNK_SECONDS=600
ASR_CHUNK_OVERLAP_SECONDS=2

# API-first production profile. Provider-native word timestamps are authoritative.
# The local/qualification ASR path can still opt into faster-whisper/WhisperX, but
# production API mode must not require that heavyweight runtime.
WHISPER_MODEL=medium
WHISPER_SECONDARY_MODEL=small
REQUIRE_ASR_CONSENSUS=false
ALIGNMENT_BACKEND=native
REQUIRE_FORCED_ALIGNMENT=false
# Legacy/local forced-alignment example (qualification or an explicitly chosen
# deployment only): WORKER_IMAGE_TARGET=worker, ASR_MODE=local,
# ALIGNMENT_BACKEND=whisperx, REQUIRE_FORCED_ALIGNMENT=true.
# Protect RAM/CPU by allowing one source video inside the complete ASR pipeline at a time.
# ASR_WORKERS below is faster-whisper's internal worker count for that one active source.
ASR_CONCURRENCY=1
ASR_CPU_THREADS=4
ASR_WORKERS=1
RENDER_CONCURRENCY=1
