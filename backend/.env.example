APP_ENV=development
DATABASE_BACKEND=sqlite
DATABASE_URL=
STORAGE_BACKEND=local
GCS_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=
JOB_BACKEND=local
GCP_PROJECT_ID=
GCP_REGION=
CLOUD_RUN_MEDIA_JOB_NAME=
# Internal QA only. Keep false for normal creator/dev accounts; production creators are always blocked.
ALLOW_MANUAL_ANALYSIS_IN_DEVELOPMENT=false
SECRET_KEY=change-this-before-production
ACCESS_TOKEN_MINUTES=10080
DATABASE_PATH=./storage/clipkaro.db
# SQLite concurrency hardening. Keep WAL enabled; these values control how long
# each connection waits for a writer and how many whole-operation retries occur
# after a transient SQLITE_BUSY/SQLITE_LOCKED error.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_LOCK_MAX_ATTEMPTS=4
SQLITE_LOCK_RETRY_BASE_MS=50
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=15
FILE_EXPIRY_HOURS=24
WHISPER_MODEL=medium
WHISPER_FALLBACK_MODEL=small
WHISPER_SECONDARY_MODEL=small
REQUIRE_ASR_CONSENSUS=true
# Laptop/dev: native (honest Whisper word timestamps). Production quality worker: whisperx.
ALIGNMENT_BACKEND=native
# Set true in production after installing requirements-alignment.txt.
REQUIRE_FORCED_ALIGNMENT=false
HINDI_CAPTION_SCRIPT=roman
MODEL_CACHE_DIR=./storage/models
TRANSCRIPTION_BACKEND=faster-whisper
# Production API-first ASR. Local Whisper/WhisperX remains ASR_MODE=local only.
ASR_MODE=api
ASR_PRIMARY_PROVIDER=groq
ASR_FALLBACK_PROVIDER=cloudflare
GROQ_ASR_MODEL=whisper-large-v3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ASR_MODEL=@cf/openai/whisper-large-v3-turbo
# Controlled Hinglish-only staging route.  These safe defaults retain the
# existing Groq -> Cloudflare route.  To enable the reviewed candidate, set
# HINGLISH_ASR_PROVIDER=elevenlabs and ROMAN_HINGLISH_ENABLED=true privately.
HINGLISH_ASR_PROVIDER=legacy
ROMAN_HINGLISH_ENABLED=false
HINGLISH_STAGE1_ENABLED=false
HINGLISH_STAGE1_USER_IDS=
ROMAN_HINGLISH_POLICY=v3
ROMAN_HINGLISH_DISPLAY_POLICY=v1
ELEVENLABS_API_KEY=
# Optional comma-separated private rotation pool. This is used only when
# ElevenLabs returns a genuine rate-limit/quota response; it is never sent as
# one combined credential and never rotates on authentication/request errors.
ELEVENLABS_API_KEYS=
ASR_PROVIDER_TIMEOUT_SECONDS=45
ASR_PROVIDER_MAX_ATTEMPTS=2
ASR_API_MAX_AUDIO_MINUTES=60
ASR_API_MAX_CHUNK_MB=24
ASR_API_MAX_CHUNKS=24
ASR_CHUNK_SECONDS=600
ASR_CHUNK_OVERLAP_SECONDS=2
# Test automation only: set APP_ENV=test and TRANSCRIPTION_BACKEND=fixture
TRANSCRIPTION_FIXTURE_PATH=./sample_data/e2e_segments.json
AUTO_LANGUAGE_BIAS=india
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_USER=false
# Optional local-only demo seed. Set both only if you explicitly enable it.
DEMO_EMAIL=
DEMO_PASSWORD=
RENDER_CONCURRENCY=1
# Local development runs jobs through FastAPI BackgroundTasks for convenience.
# Production Compose overrides this to worker and starts `python -m app.worker`.
JOB_EXECUTION_MODE=background
WORKER_POLL_SECONDS=0.75
# Number of source videos allowed inside Whisper/ASR simultaneously.
# Keep 1 on memory-constrained hosts. This is NOT the same as ASR_WORKERS below.
ASR_CONCURRENCY=1
# faster-whisper CPU threads/workers used inside one active source transcription.
ASR_CPU_THREADS=4
ASR_WORKERS=1

# Security foundation: persisted/revocable sessions and one-time password resets.
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

# Upload security. Local development may leave CLAMAV_HOST empty and scanning is
# skipped. Production sets UPLOAD_SCAN_REQUIRED=true and runs the private sidecar.
UPLOAD_SCAN_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_CHUNK_KB=256

# Bound FFmpeg/FFprobe work. Docker CPU/RAM/PID limits are the outer host-safety boundary.
MEDIA_PROCESS_TIMEOUT_SECONDS=1800
MEDIA_FFMPEG_THREADS=2

# Email verification uses Resend. Configure a verified Resend sender domain;
# no verification URL/token is ever written to local logs. The legacy SMTP
# variables below remain only for the existing password-reset mail path.
EMAIL_VERIFICATION_REQUIRED=true
RESEND_API_KEY=
EMAIL_FROM=ClipKaro AI <verify@your-verified-domain.com>
FRONTEND_URL=http://localhost:3000
# APP_PUBLIC_URL is retained as a compatibility fallback for existing links.
APP_PUBLIC_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
# Legacy password-reset SMTP configuration (not used by email verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ClipKaro AI
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Razorpay mode must match the configured key type. Keep the live-development
# opt-in false unless you intentionally want localhost to create REAL Razorpay
# live orders/subscriptions for merchant integration testing.
RAZORPAY_MODE=test
ALLOW_LIVE_RAZORPAY_IN_DEVELOPMENT=false

# Public legal/consumer particulars. Development may leave these blank; staging/
# production treat them as a paid-launch gate. Use the actual operator details.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=legal@clipkaro.pro
PRIVACY_CONTACT_EMAIL=privacy@clipkaro.pro
CUSTOMER_CARE_EMAIL=support@clipkaro.pro
CUSTOMER_CARE_PHONE=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=grievance@clipkaro.pro
GRIEVANCE_PHONE=
LEGAL_GSTIN=
LEGAL_PAN=

# Semantic best-moment ranking. Never commit real Groq credentials. Production
# Compose mounts these only into the isolated media worker, not the public API.
GROQ_RANKING_ENABLED=true
GROQ_RANKING_MODEL=openai/gpt-oss-120b
GROQ_RANKING_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_RANKING_TIMEOUT_SECONDS=18
GROQ_RANKING_CANDIDATES=16
# Preferred: comma-separated server-side secret list. Keys are redundancy only;
# ClipKaro never rotates keys to evade organization-level rate limits.
GROQ_API_KEYS=
# Optional individual slots if your secret manager/VPS stores them separately.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional. Windows automatically uses Nirmala UI for Hindi/Indic captions.
# Set an absolute Unicode font path to override it in production containers.
CAPTION_FONT_FILE=
# Razorpay plan IDs are created/reused automatically by the backend on first checkout.
# Configure the same RAZORPAY_WEBHOOK_SECRET in Razorpay Dashboard -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Creator Pulse — server-side only. Never expose this key through NEXT_PUBLIC_* variables.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_TIMEOUT_SECONDS=7

# YouTube link ingestion. Production defaults to native until a dedicated
# clean-egress worker has been certified. Worker credentials are server-side only.
YOUTUBE_INGESTION_PROVIDER=native
YOUTUBE_INGESTION_WORKER_URL=
YOUTUBE_INGESTION_WORKER_SECRET=
YOUTUBE_INGESTION_WORKER_TIMEOUT_SECONDS=900
YOUTUBE_INGESTION_WORKER_UPLOAD_TTL_SECONDS=1200
SOCIALKIT_ACCESS_KEY=
SOCIALKIT_API_BASE_URL=https://api.socialkit.dev
SOCIALKIT_POLL_INTERVAL_SECONDS=3
SOCIALKIT_TIMEOUT_SECONDS=600
SOCIALKIT_DOWNLOAD_TIMEOUT_SECONDS=120
SOCIALKIT_QUALITY=480p
SOCIALKIT_DOWNLOAD_HOST_SUFFIXES=socialkit.dev,amazonaws.com,cloudfront.net
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
