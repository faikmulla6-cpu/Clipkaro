{
  "name": "@clipkaro/cartoon-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "check:demo": "hyperframes check --json",
    "render:demo": "hyperframes render --quality draft -o demo.mp4",
    "build": "esbuild animation/index.tsx --bundle --minify --global-name=ClipKaroAnimation --outfile=dist/animation.js"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.9.72",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
