{
  "name": "@clipkaro/cartoon-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "test:story": "node --test animation/story-v3.test.mjs",
    "check:demo": "hyperframes check --json",
    "render:demo": "hyperframes render --quality draft -o demo.mp4",
    "build": "esbuild animation/index.tsx --bundle --jsx-factory=h --jsx-fragment=Fragment --minify --global-name=ClipKaroAnimation --outfile=dist/animation.js"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.9.72",
    "esbuild": "0.28.2",
    "preact": "11.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
