# ClipKaro Modal + S3-compatible production reference. Never commit real values.
APP_ENV=production
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
STORAGE_BACKEND=gcs
OBJECT_STORAGE_PROVIDER=s3
JOB_BACKEND=cloud_run_job
JOB_EXECUTION_PROVIDER=modal
MODAL_APP_NAME=clipkaro-production
MODAL_MEDIA_FUNCTION=run_media_job
MODAL_ENVIRONMENT=main
S3_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
S3_REGION=REGION
S3_BUCKET_NAME=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=__REQUIRED__
S3_SECRET_ACCESS_KEY=__REQUIRED__
SECRET_KEY=__REQUIRED_32_PLUS_RANDOM_CHARS__
FRONTEND_URL=https://clipkaro.pro
APP_PUBLIC_URL=https://clipkaro.pro
CORS_ORIGINS=https://clipkaro.pro
EMAIL_FROM=ClipKaro AI <verify@clipkaro.pro>
RESEND_API_KEY=__REQUIRED__
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=__REQUIRED__
RAZORPAY_KEY_SECRET=__REQUIRED__
RAZORPAY_WEBHOOK_SECRET=__REQUIRED__
GROQ_API_KEYS=__REQUIRED__
CLOUDFLARE_ACCOUNT_ID=__REQUIRED__
CLOUDFLARE_API_TOKEN=__REQUIRED__
ELEVENLABS_API_KEYS=__CONTROLLED_STAGE1_ONLY__
ASR_MODE=api
UPLOAD_SCAN_REQUIRED=true
CLAMAV_HOST=local
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=4
POSTGRES_STATEMENT_CACHE_SIZE=0
PRODUCTION_CREDENTIALS_ROTATED=false
